Writing Logs (For Developers)
// C++ Native Code
#include <log/log.h>

ALOGV("Verbose message: %d", value);    // Verbose
ALOGD("Debug message: %s", str);        // Debug
ALOGI("Info message");                   // Info
ALOGW("Warning: something unusual");     // Warning
ALOGE("Error: operation failed");        // Error

// With custom tag
#define LOG_TAG "MyComponent"
ALOGI("This will appear as I/MyComponent: ...");

// Java/Kotlin Code
import android.util.Log;

Log.v("MyApp", "Verbose message");
Log.d("MyApp", "Debug message");
Log.i("MyApp", "Info message");
Log.w("MyApp", "Warning message");
Log.e("MyApp", "Error message");



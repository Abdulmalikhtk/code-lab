Camera Stream Configuration:
// Stream types and configurations
struct StreamConfiguration {
    // Stream types:
    // - OUTPUT: Data goes from camera to app
    // - INPUT: Data goes from app to camera (reprocessing)
    StreamType type;
    
    // Stream formats:
    // - IMPLEMENTATION_DEFINED: Gralloc selects optimal format
    // - YCbCr_420_888: Standard YUV for image processing
    // - JPEG: Compressed still capture
    // - RAW_SENSOR: Raw Bayer data
    PixelFormat format;
    
    // Resolution
    uint32_t width;
    uint32_t height;
    
    // Usage flags (Gralloc)
    BufferUsage usage;
    
    // Rotation
    StreamRotation rotation;
};

// Example multi-stream configuration
void configureStreams() {
    StreamConfiguration config;
    
    // Preview stream (display)
    config.streams.push_back({
        .id = 0,
        .streamType = StreamType::OUTPUT,
        .width = 1920,
        .height = 1080,
        .format = PixelFormat::IMPLEMENTATION_DEFINED,
        .usage = BufferUsage::GPU_TEXTURE | BufferUsage::COMPOSER_OVERLAY
    });
    
    // Still capture stream (JPEG)
    config.streams.push_back({
        .id = 1,
        .streamType = StreamType::OUTPUT,
        .width = 4032,
        .height = 3024,
        .format = PixelFormat::BLOB,  // JPEG
        .usage = BufferUsage::CPU_READ
    });
    
    // Video recording stream
    config.streams.push_back({
        .id = 2,
        .streamType = StreamType::OUTPUT,
        .width = 3840,
        .height = 2160,

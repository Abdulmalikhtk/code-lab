What Driver Outputs (Raw Hardware Data)
1. Image Data (Frame Buffer)
// Driver returns raw pixel data in a buffer
struct DriverFrameOutput {
    void* buffer;              // Raw pixel data pointer
    size_t size;               // Buffer size in bytes
    uint32_t width;            // 4032
    uint32_t height;           // 3024
    uint32_t format;           // RAW_BAYER_RGGB (raw sensor pattern)
    uint64_t timestamp_ns;     // When frame was captured
    uint32_t frame_number;     // Sequential frame ID
};

// Example raw Bayer data (what sensor actually captures):
// ┌───┬───┬───┬───┐
// │ R │ G │ R │ G │  ← Red and Green pixels
// ├───┼───┼───┼───┤
// │ G │ B │ G │ B │  ← Green and Blue pixels
// ├───┼───┼───┼───┤
// │ R │ G │ R │ G │
// └───┴───┴───┴───┘

2. Sensor Statistics (For 3A)
// Driver provides statistics for auto-algorithms
struct DriverSensorStats {
    // For Auto Exposure (AE)
    uint32_t brightness_histogram[256];  // How bright is the image?
    uint32_t avg_brightness;             // Average pixel value
    
    // For Auto Focus (AF)
    uint32_t focus_score;                // Sharpness measure (higher = sharper)
    uint32_t phase_detect_data[1024];    // PDAF sensor data
    
    // For Auto White Balance (AWB)
    uint32_t r_sum, g_sum, b_sum;        // Color channel totals
    uint32_t color_temperature;          // Estimated light temp (Kelvin)
    
    // Sensor health
    int32_t sensor_temperature;          // Sensor temp in Celsius
};

3. Hardware Status
// Driver reports hardware state
struct DriverStatus {
    bool frame_ready;           // New frame available
    bool error_occurred;        // Hardware error
    uint32_t dropped_frames;    // Frames lost
    uint32_t current_exposure;  // Current exposure setting
    uint32_t current_gain;      // Current ISO/gain setting
};


How HAL Processes This Data
Step 1: Read from Driver
// HAL reads frame from driver via V4L2 or vendor API
int CameraHAL::readFrameFromDriver(DriverFrameOutput* frame) {
    // Open device node
    int fd = open("/dev/video0", O_RDWR);
    
    // Dequeue buffer (get frame from driver)
    struct v4l2_buffer buf;
    ioctl(fd, VIDIOC_DQBUF, &buf);
    
    // Frame data is now in buf
    frame->buffer = mBuffers[buf.index].start;
    frame->timestamp_ns = buf.timestamp.tv_sec * 1000000000LL + 
                          buf.timestamp.tv_usec * 1000;
    
    return 0;
}

Step 2: Process with ISP (Image Signal Processor)
// Convert raw Bayer → YUV/RGB that apps can use
void CameraHAL::processFrame(DriverFrameOutput* raw, OutputBuffer* output) {
    
    // 1. Demosaic: Convert Bayer RGGB → Full RGB
    //    Raw:  R G R G      RGB: (R,G,B) (R,G,B)
    //          G B G B  →        (R,G,B) (R,G,B)
    demosaic(raw->buffer, rgb_buffer);
    
    // 2. Apply White Balance (color correction)
    //    Multiply R,G,B by gains to neutralize color cast
    applyWhiteBalance(rgb_buffer, awb_gains);
    
    // 3. Apply Color Correction Matrix
    //    Fine-tune colors for accuracy
    applyColorCorrection(rgb_buffer, ccm_matrix);
    
    // 4. Gamma Correction (make image look natural)
    applyGamma(rgb_buffer, gamma_curve);
    
    // 5. Convert to output format (YUV for preview, JPEG for capture)
    if (output->format == YUV_420) {
        rgbToYuv(rgb_buffer, output->buffer);
    } else if (output->format == JPEG) {
        rgbToJpeg(rgb_buffer, output->buffer, quality=95);
    }
}

Step 3: Run 3A Algorithms
// Use sensor statistics to adjust camera settings
void CameraHAL::run3A(DriverSensorStats* stats) {
    
    // AUTO EXPOSURE: Adjust brightness
    if (stats->avg_brightness < 100) {
        // Image too dark → increase exposure or gain
        new_exposure = current_exposure * 1.2;
        setDriverExposure(new_exposure);
    } else if (stats->avg_brightness > 200) {
        // Image too bright → decrease exposure
        new_exposure = current_exposure * 0.8;
        setDriverExposure(new_exposure);
    }
    
    // AUTO FOCUS: Adjust lens position
    if (stats->focus_score < threshold) {
        // Image blurry → search for better focus
        moveLens(FOCUS_SEARCH);
    }
    
    // AUTO WHITE BALANCE: Correct colors
    float r_gain = stats->g_sum / stats->r_sum;  // Normalize to green
    float b_gain = stats->g_sum / stats->b_sum;
    setWhiteBalanceGains(r_gain, 1.0, b_gain);
}

Step 4: Send Result to Framework
// Package processed data for Android Framework
void CameraHAL::sendResult(uint32_t frameNumber, OutputBuffer* buffer) {
    
    // Build result metadata (what settings were actually used)
    CaptureResult result;
    result.frameNumber = frameNumber;
    
    // Add actual capture settings to result
    result.metadata.update(ANDROID_SENSOR_EXPOSURE_TIME, actual_exposure);
    result.metadata.update(ANDROID_SENSOR_SENSITIVITY, actual_iso);
    result.metadata.update(ANDROID_CONTROL_AE_STATE, AE_CONVERGED);
    result.metadata.update(ANDROID_CONTROL_AF_STATE, AF_FOCUSED);
    result.metadata.update(ANDROID_SENSOR_TIMESTAMP, capture_timestamp);
    
    // Attach output buffer
    result.outputBuffers.push_back(buffer);
    
    // Send to Framework via callback
    mCallback->processCaptureResult(result);
}



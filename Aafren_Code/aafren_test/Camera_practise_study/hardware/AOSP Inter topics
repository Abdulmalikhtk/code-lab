HIDL HAL Example:
// 1. Interface Definition (.hal file)
// hardware/interfaces/example/1.0/IExample.hal
package android.hardware.example@1.0;

interface IExample {
    initialize() generates (Status status);
    getData() generates (vec<uint8_t> data);
    setCallback(IExampleCallback callback);
};

// 2. HAL Implementation
class ExampleImpl : public IExample {
public:
    Return<Status> initialize() override {
        // Initialize hardware
        return Status::OK;
    }
    
    Return<void> getData(getData_cb _hidl_cb) override {
        std::vector<uint8_t> data = readFromHardware();
        _hidl_cb(data);
        return Void();
    }
};

// 3. Service Registration
int main() {
    configureRpcThreadpool(1, true);
    
    sp<IExample> service = new ExampleImpl();
    service->registerAsService();
    
    joinRpcThreadpool();
    return 0;
}



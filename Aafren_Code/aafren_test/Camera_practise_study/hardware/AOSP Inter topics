Camera HAL3 Interface Hierarchy:
// 1. ICameraProvider - Entry point for camera subsystem
interface ICameraProvider {
    // Get list of cameras
    getCameraIdList() generates (Status status, vec<string> cameraIds);
    
    // Open a camera device
    getCameraDeviceInterface(string cameraId) 
        generates (Status status, ICameraDevice device);
    
    // Set callback for camera device status changes
    setCallback(ICameraProviderCallback callback);
};

// 2. ICameraDevice - Represents a physical camera
interface ICameraDevice {
    // Get static camera characteristics
    getCameraCharacteristics() 
        generates (Status status, CameraMetadata metadata);
    
    // Open camera and create session
    open(ICameraDeviceCallback callback) 
        generates (Status status, ICameraDeviceSession session);
};

// 3. ICameraDeviceSession - Active camera session
interface ICameraDeviceSession {
    // Configure streams (preview, capture, video)
    configureStreams(StreamConfiguration config)
        generates (Status status, HalStreamConfiguration halConfig);
    
    // Submit capture request
    processCaptureRequest(vec<CaptureRequest> requests)
        generates (Status status, uint32_t numRequestProcessed);
    
    // Flush pending requests
    flush() generates (Status status);
    
    // Close session
    close();
};

Camera HAL Implementation Details:
// CameraDeviceSession Implementation
class CameraDeviceSession : public ICameraDeviceSession {
public:
    // Configure output streams
    Return<void> configureStreams(
        const StreamConfiguration& requestedConfig,
        configureStreams_cb _hidl_cb) override {
        
        HalStreamConfiguration halConfig;
        
        for (const auto& stream : requestedConfig.streams) {
            HalStream halStream;
            halStream.id = stream.id;
            halStream.overrideFormat = stream.format;
            halStream.maxBuffers = MAX_BUFFERS;
            
            // Configure hardware for this stream
            configureHardwareStream(stream);
            
            halConfig.streams.push_back(halStream);
        }
        
        _hidl_cb(Status::OK, halConfig);
        return Void();
    }
    
    // Process capture request
    Return<void> processCaptureRequest(
        const hidl_vec<CaptureRequest>& requests,
        processCaptureRequest_cb _hidl_cb) override {
        
        for (const auto& request : requests) {
            // Queue request to hardware
            mRequestQueue.push(request);
            
            // Trigger hardware capture
            triggerCapture(request.frameNumber);
        }
        
        _hidl_cb(Status::OK, requests.size());
        return Void();
    }

private:
    // Hardware interrupt handler
    void onFrameAvailable(uint32_t frameNumber) {
        CaptureResult result;
        result.frameNumber = frameNumber;
        result.partialResult = 1;
        
        // Fill result metadata
        fillResultMetadata(result.result);
        
        // Notify framework
        mCallback->processCaptureResult(result);
    }
};


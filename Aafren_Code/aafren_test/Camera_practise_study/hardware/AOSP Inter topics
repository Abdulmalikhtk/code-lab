Advanced Configuration
# ============================================================================
# ADVANCED PERFETTO WITH CONFIG FILE
# ============================================================================

# Create config file (trace_config.pbtx)
cat > /tmp/trace_config.pbtx << 'EOF'
buffers {
  size_kb: 63488
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "camera/*"
    }
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      proc_stats_poll_ms: 100
    }
  }
}

duration_ms: 10000
EOF

# Push config to device
adb push /tmp/trace_config.pbtx /data/local/tmp/

# Run with config
adb shell perfetto \
  -c /data/local/tmp/trace_config.pbtx \
  -o /data/misc/perfetto-traces/trace.perfetto

# Pull and view
adb pull /data/misc/perfetto-traces/trace.perfetto ./


// BpCameraProvider (Binder Proxy - auto-generated)
Return<void> BpHwCameraProvider::getCameraIdList(getCameraIdList_cb _hidl_cb) {
    // Serialize method call
    Parcel _hidl_data;
    _hidl_data.writeInterfaceToken(ICameraProvider::descriptor);
    
    // Send via Binder driver
    Parcel _hidl_reply;
    _hidl_transact(1 /* method id */, _hidl_data, &_hidl_reply);
    
    // Deserialize response
    Status _hidl_status;
    _hidl_reply.readInt32(&_hidl_status);
    hidl_vec<hidl_string> _hidl_ids;
    _hidl_reply.readStringVector(&_hidl_ids);
    
    // Call callback with results
    _hidl_cb(_hidl_status, _hidl_ids);
    return Void();
}

// ═══════════════════════════════════════════════════════════════════════════
// SERVER SIDE (Your HAL - ExampleCameraProvider.cpp)
// ═══════════════════════════════════════════════════════════════════════════

// 3. YOUR implementation is called
Return<void> ExampleCameraProvider::getCameraIdList(getCameraIdList_cb _hidl_cb) {
    // Your actual implementation
    hidl_vec<hidl_string> cameraIds(2);
    cameraIds[0] = "device@3.5/internal/0";
    cameraIds[1] = "device@3.5/internal/1";
    
    // Return results via callback
    _hidl_cb(Status::OK, cameraIds);
    return Void();
}

